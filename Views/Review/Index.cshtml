@model List<LeaveRequest>

@{
    ViewData["Title"] = "主管簽核";
    var taipeiZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Taipei");

    static string LeaveTypeLabel(LeaveType type) => type switch
    {
        LeaveType.Annual => "特休",
        LeaveType.Sick => "病假",
        LeaveType.Personal => "事假",
        LeaveType.Other => "其他",
        _ => type.ToString()
    };
}

<h1>主管簽核</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!Model.Any())
{
    <p>目前沒有待簽核的申請</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>員工姓名</th>
                <th>部門</th>
                <th>假別</th>
                <th>開始日期</th>
                <th>結束日期</th>
                <th>請假天數</th>
                <th>請假理由</th>
                <th>建立時間</th>
                <th>簽核</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Employee?.Name</td>
                    <td>@item.Employee?.Department</td>
                    <td>@LeaveTypeLabel(item.LeaveType)</td>
                    <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.Days</td>
                    <td>@item.Reason</td>
                    <td>@TimeZoneInfo.ConvertTimeFromUtc(item.CreatedAt, taipeiZone).ToString("yyyy-MM-dd HH:mm") (UTC+8)</td>
                    <td>
                        <form asp-controller="Review" asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-flex gap-2 align-items-start">
                            <textarea name="note" maxlength="200" class="form-control form-control-sm" rows="1" placeholder="簽核備註（選填）"></textarea>
                            <button type="submit" asp-action="Approve" asp-route-id="@item.Id" class="btn btn-sm btn-success text-nowrap">核准</button>
                            <button type="submit" asp-action="Reject" asp-route-id="@item.Id" class="btn btn-sm btn-danger text-nowrap">駁回</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
