@using Microsoft.AspNetCore.Mvc.Rendering
@model List<LeaveRequest>

@{
    ViewData["Title"] = "請假申請清單";
    var taipeiZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Taipei");

    static string LeaveTypeLabel(LeaveType type) => type switch
    {
        LeaveType.Annual => "特休",
        LeaveType.Sick => "病假",
        LeaveType.Personal => "事假",
        LeaveType.Other => "其他",
        _ => type.ToString()
    };

    static string StatusLabel(LeaveStatus status) => status switch
    {
        LeaveStatus.Pending => "待審核",
        LeaveStatus.Approved => "已核准",
        LeaveStatus.Rejected => "已駁回",
        LeaveStatus.Cancelled => "已取消",
        _ => status.ToString()
    };

    static string StatusPillClass(LeaveStatus status) => status switch
    {
        LeaveStatus.Pending => "status-pill-pending",
        LeaveStatus.Approved => "status-pill-approved",
        LeaveStatus.Rejected => "status-pill-rejected",
        LeaveStatus.Cancelled => "status-pill-cancelled",
        _ => "status-pill-pending"
    };
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <h1 class="mb-0">請假申請清單</h1>
    <div class="d-flex gap-2">
        <a asp-controller="LeaveRequests" asp-action="Create" class="btn btn-primary">新增申請</a>
        <a asp-controller="Review" asp-action="Index" class="btn btn-outline-primary">主管簽核</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<form asp-controller="LeaveRequests" asp-action="Index" method="get" class="mb-4 d-flex align-items-center gap-2">
    <label for="statusFilter" class="form-label mb-0">狀態篩選</label>
    <select id="statusFilter" name="status" class="form-select w-auto" onchange="this.form.submit()">
        @foreach (var option in (IEnumerable<SelectListItem>)ViewData["StatusOptions"]!)
        {
            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
        }
    </select>
</form>

@if (!Model.Any())
{
    <div class="lf-empty-state">
        <div class="lf-empty-state-icon"></div>
        <div class="lf-empty-state-text">目前沒有請假申請</div>
    </div>
}
else
{
    <div class="lf-card p-2">
        <div class="d-none d-md-grid" style="grid-template-columns:1.2fr 1fr 1fr 1fr 1fr 0.8fr 1.2fr 1.2fr;padding:16px 20px;font-size:13px;font-weight:600;color:var(--lf-text-secondary);text-transform:uppercase;letter-spacing:0.03em">
            <div>員工</div>
            <div>假別</div>
            <div>開始日期</div>
            <div>結束日期</div>
            <div>天數</div>
            <div>狀態</div>
            <div>建立時間</div>
            <div>操作</div>
        </div>
        @foreach (var item in Model)
        {
            <div class="lf-leave-mobile-card d-md-none">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <div class="fw-semibold" style="font-size:15px">@item.Employee?.Name</div>
                        <div style="font-size:13px;color:var(--lf-text-muted)">@item.Employee?.Department</div>
                    </div>
                    <span class="status-pill @StatusPillClass(item.Status)">@StatusLabel(item.Status)</span>
                </div>
                <div class="d-grid gap-2" style="grid-template-columns:1fr 1fr">
                    <div>
                        <div class="lf-leave-mobile-card-label">假別</div>
                        <div style="font-size:15px">@LeaveTypeLabel(item.LeaveType)</div>
                    </div>
                    <div>
                        <div class="lf-leave-mobile-card-label">天數</div>
                        <div style="font-size:15px">@item.Days</div>
                    </div>
                    <div style="grid-column:1 / -1">
                        <div class="lf-leave-mobile-card-label">期間</div>
                        <div style="font-size:15px">@item.StartDate.ToString("yyyy-MM-dd") ~ @item.EndDate.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div style="grid-column:1 / -1">
                        <div class="lf-leave-mobile-card-label">建立時間</div>
                        <div style="font-size:13px;color:var(--lf-text-muted)">@TimeZoneInfo.ConvertTimeFromUtc(item.CreatedAt, taipeiZone).ToString("yyyy-MM-dd HH:mm") (UTC+8)</div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <a asp-controller="LeaveRequests" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">詳細</a>
                    @if (item.Status == LeaveStatus.Pending)
                    {
                        <a asp-controller="LeaveRequests" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">編輯</a>
                        <form asp-controller="LeaveRequests" asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="button" class="btn btn-sm btn-outline-danger" data-cancel-modal-trigger>取消</button>
                        </form>
                    }
                </div>
            </div>
            <div class="d-none d-md-grid gap-1" style="grid-template-columns:1.2fr 1fr 1fr 1fr 1fr 0.8fr 1.2fr 1.2fr;align-items:center;padding:18px 20px;border-top:1px solid var(--lf-border-soft)">
                <div>
                    <div class="fw-semibold" style="font-size:15px">@item.Employee?.Name</div>
                    <div style="font-size:13px;color:var(--lf-text-muted)">@item.Employee?.Department</div>
                </div>
                <div style="font-size:15px">@LeaveTypeLabel(item.LeaveType)</div>
                <div style="font-size:15px">@item.StartDate.ToString("yyyy-MM-dd")</div>
                <div style="font-size:15px">@item.EndDate.ToString("yyyy-MM-dd")</div>
                <div style="font-size:15px">@item.Days</div>
                <div><span class="status-pill @StatusPillClass(item.Status)">@StatusLabel(item.Status)</span></div>
                <div style="font-size:13px;color:var(--lf-text-muted)">@TimeZoneInfo.ConvertTimeFromUtc(item.CreatedAt, taipeiZone).ToString("yyyy-MM-dd HH:mm") (UTC+8)</div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="LeaveRequests" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">詳細</a>
                    @if (item.Status == LeaveStatus.Pending)
                    {
                        <a asp-controller="LeaveRequests" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">編輯</a>
                        <form asp-controller="LeaveRequests" asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="button" class="btn btn-sm btn-outline-danger" data-cancel-modal-trigger>取消</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
    @await Html.PartialAsync("_CancelConfirmModal")
}
