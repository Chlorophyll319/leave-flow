@model LeaveRequest

@{
    ViewData["Title"] = "請假申請詳細資料";
    var taipeiZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Taipei");

    static string LeaveTypeLabel(LeaveType type) => type switch
    {
        LeaveType.Annual => "特休",
        LeaveType.Sick => "病假",
        LeaveType.Personal => "事假",
        LeaveType.Other => "其他",
        _ => type.ToString()
    };

    static string StatusLabel(LeaveStatus status) => status switch
    {
        LeaveStatus.Pending => "待審核",
        LeaveStatus.Approved => "已核准",
        LeaveStatus.Rejected => "已駁回",
        LeaveStatus.Cancelled => "已取消",
        _ => status.ToString()
    };

    static string StatusPillClass(LeaveStatus status) => status switch
    {
        LeaveStatus.Pending => "status-pill-pending",
        LeaveStatus.Approved => "status-pill-approved",
        LeaveStatus.Rejected => "status-pill-rejected",
        LeaveStatus.Cancelled => "status-pill-cancelled",
        _ => "status-pill-pending"
    };
}

<h1 class="mb-4">請假申請詳細資料</h1>

<div class="lf-card p-4" style="max-width:720px">
    <div class="d-grid gap-3" style="grid-template-columns:1fr 1fr">
        <div>
            <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">員工姓名</div>
            <div style="font-size:15px">@Model.Employee?.Name</div>
        </div>
        <div>
            <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">部門</div>
            <div style="font-size:15px">@Model.Employee?.Department</div>
        </div>
        <div>
            <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">假別</div>
            <div style="font-size:15px">@LeaveTypeLabel(Model.LeaveType)</div>
        </div>
        <div>
            <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">狀態</div>
            <div><span class="status-pill @StatusPillClass(Model.Status)">@StatusLabel(Model.Status)</span></div>
        </div>
        <div>
            <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">開始日期</div>
            <div style="font-size:15px">@Model.StartDate.ToString("yyyy-MM-dd")</div>
        </div>
        <div>
            <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">結束日期</div>
            <div style="font-size:15px">@Model.EndDate.ToString("yyyy-MM-dd")</div>
        </div>
        <div>
            <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">請假天數</div>
            <div style="font-size:15px">@Model.Days</div>
        </div>
        <div>
            <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">建立時間</div>
            <div style="font-size:15px">@TimeZoneInfo.ConvertTimeFromUtc(Model.CreatedAt, taipeiZone).ToString("yyyy-MM-dd HH:mm") (UTC+8)</div>
        </div>
        <div style="grid-column:1 / -1">
            <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">請假理由</div>
            <div style="font-size:15px">@Model.Reason</div>
        </div>

        @if (Model.Status is LeaveStatus.Approved or LeaveStatus.Rejected)
        {
            <div>
                <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">簽核備註</div>
                <div style="font-size:15px">@Model.DecisionNote</div>
            </div>
            <div>
                <div style="font-size:13px;font-weight:600;color:var(--lf-text-secondary)">簽核時間</div>
                <div style="font-size:15px">@TimeZoneInfo.ConvertTimeFromUtc(Model.DecidedAt!.Value, taipeiZone).ToString("yyyy-MM-dd HH:mm") (UTC+8)</div>
            </div>
        }
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    @if (Model.Status == LeaveStatus.Pending)
    {
        <a asp-controller="LeaveRequests" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">編輯</a>
        <form asp-controller="LeaveRequests" asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('確定要取消這筆請假申請嗎？');">
            <button type="submit" class="btn btn-danger">取消</button>
        </form>
    }
    <a asp-controller="LeaveRequests" asp-action="Index" class="btn btn-secondary">返回清單</a>
</div>
