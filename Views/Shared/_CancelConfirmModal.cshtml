<dialog id="cancelConfirmModal" class="lf-modal" aria-labelledby="cancelConfirmTitle" aria-describedby="cancelConfirmMessage">
    <div class="lf-modal-icon">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="9" stroke="currentColor" stroke-width="1.8" />
            <path d="M11 6.5v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            <circle cx="11" cy="15.2" r="1.1" fill="currentColor" />
        </svg>
    </div>
    <div id="cancelConfirmTitle" class="lf-modal-title">取消請假申請</div>
    <div id="cancelConfirmMessage" class="lf-modal-message">確定要取消這筆請假申請嗎？取消後資料將保留，但無法復原此動作。</div>
    <div class="lf-modal-actions">
        <button type="button" class="btn btn-secondary" data-cancel-modal-close>返回</button>
        <button type="button" class="btn btn-danger" data-cancel-modal-confirm>確定取消</button>
    </div>
</dialog>
